{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/evaluate-session.js\"",
            "commandWindows": "node \"%CLAUDE_PLUGIN_ROOT%\\scripts\\hooks\\evaluate-session.js\"",
            "timeout": 30,
            "statusMessage": "Learning mobile patterns..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-compact.js\"",
            "commandWindows": "node \"%CLAUDE_PLUGIN_ROOT%\\scripts\\hooks\\pre-compact.js\"",
            "timeout": 30,
            "statusMessage": "Saving mobile session context..."
          }
        ]
      }
    ]
  }
}
